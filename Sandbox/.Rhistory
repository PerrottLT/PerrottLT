round_n_suppress <- function(x) {
ifelse(abs(x - floor(x)) < 0.5, floor(x / 5) * 5, ceiling(x / 5) * 5)
}
round_n_suppress(2.49)
round_n_suppress(2.50)
round_n_suppress(2.51)
