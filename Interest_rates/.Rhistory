}
# Function to calculate compound interest
calculate_compound_interest <- function(principal, rate, time_in_years) {
principal * (1 + rate) ^ time_in_years - principal
}
# Function to calculate monthly payment
calculate_monthly_payment <- function(principal, annual_interest_rate, duration_in_months) {
r <- annual_interest_rate / 12  # Monthly interest rate
M <- (principal * r * (1 + r)^duration_in_months) / ((1 + r)^duration_in_months - 1)
return(M)
}
# Function to process overpayment effects
process_overpayment <- function(start_date, loan_balance, annual_interest_rate, payment_history) {
# Calculate loan term
loan_term <- start_date + months(60) # Assuming the term is 60 months from the start date
# Calculate days since last payment for the first payment
days_since_last_payment <- c(as.numeric(difftime(payment_history$Date[1], start_date, units = "days")),
diff(payment_history$Date))
# Calculate interest accrued till each payment date
interest_accrued <- calculate_daily_interest(loan_balance, annual_interest_rate) * days_since_last_payment
# Calculate interest accrued between start date and first payment date
days_between_start_and_first_payment <- as.numeric(difftime(payment_history$Date[1], start_date, units = "days"))
interest_accrued_before_first_payment <- calculate_daily_interest(loan_balance, annual_interest_rate) * days_between_start_and_first_payment
# Convert Amount column to numeric
payment_history$Amount <- as.numeric(payment_history$Amount)
# Calculate new loan balance after each payment
new_loan_balance <- loan_balance - cumsum(payment_history$Amount) + cumsum(interest_accrued)
# Adjust new loan balance for interest accrued before first payment
new_loan_balance[1] <- new_loan_balance[1] + interest_accrued_before_first_payment
# Calculate total interest saved and term reduced after each payment
total_interest_saved <- cumsum(interest_accrued)
total_term_reduced <- cumsum(payment_history$Amount)
# Calculate forecasted final date and reduction in term
forecasted_final_date <- loan_term - months(cumsum(payment_history$Amount) / loan_balance * 60) # Adjust term based on payments made
term_reduction <- loan_term - forecasted_final_date
# Calculate total interest paid with decreasing principal
monthly_payment <- calculate_monthly_payment(loan_balance, annual_interest_rate, 60)
total_interest_paid_decreasing <- calculate_total_interest_paid_decreasing(loan_balance, annual_interest_rate, 60, monthly_payment)
# Output results
cat("Loan Balance:", loan_balance, "\n")
cat("Annual Interest Rate:", annual_interest_rate, "\n")
cat("Start Date:", start_date, "\n\n")
cat("Payment History:\n")
print(payment_history)
cat("\n")
cat("Overpayment Impact:\n")
cat("Forecasted Final Date:", format(forecasted_final_date, "%Y-%m-%d"), "\n")
cat("Reduction in Term:", as.period(term_reduction), "\n")
cat("Total Interest Saved:", tail(total_interest_saved, 1), "\n")
cat("Total Interest Paid (with decreasing principal):", total_interest_paid_decreasing, "\n")
}
# Function to calculate total interest paid with decreasing principal
calculate_total_interest_paid_decreasing <- function(loan_balance, annual_interest_rate, loan_duration_months, monthly_payment) {
r <- annual_interest_rate / 12  # Monthly interest rate
remaining_principal <- loan_balance
total_interest_paid <- 0
for (i in 1:loan_duration_months) {
interest_payment <- remaining_principal * r
total_interest_paid <- total_interest_paid + interest_payment
remaining_principal <- remaining_principal - (monthly_payment - interest_payment)
}
return(total_interest_paid)
}
